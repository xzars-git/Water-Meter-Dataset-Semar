# =========# Dataset Configuration
data:
  yaml_path: "data.yaml"
  img_size: 512
  cache: true   # Enabled - 32GB RAM is sufficient for caching
  workers: 12   # Optimized for multi-core CPU=============================================================
# Water Meter AI - Training Configuration
# Author: Arsenius Purbandono
# ============================================================================

# Model Configuration
model:
  type: "yolov8n-obb" # Options: yolov8n-obb, yolov8s-obb, yolov8m-obb
  pretrained: true
  task: "obb" # Oriented Bounding Box

# Dataset Configuration
data:
  yaml_path: "data.yaml"
  img_size: 512
  cache: false # Set true if enough RAM
  workers: 8 # Number of dataloader workers

# Training Hyperparameters
training:
  epochs: 100
  batch_size: 16 # Adjust based on GPU memory
  patience: 20 # Early stopping patience

  # Optimizer
  optimizer: "AdamW" # Options: SGD, Adam, AdamW
  lr0: 0.01 # Initial learning rate
  lrf: 0.01 # Final learning rate (lr0 * lrf)
  momentum: 0.937 # SGD momentum/Adam beta1
  weight_decay: 0.0005

  # Loss weights
  box: 7.5 # Box loss gain
  cls: 0.5 # Class loss gain
  dfl: 1.5 # DFL loss gain

  # Scheduler
  warmup_epochs: 3.0
  warmup_momentum: 0.8
  warmup_bias_lr: 0.1

# Augmentation Configuration
augmentation:
  # Geometric augmentations
  hsv_h: 0.015 # HSV-Hue augmentation
  hsv_s: 0.7 # HSV-Saturation augmentation
  hsv_v: 0.4 # HSV-Value augmentation
  degrees: 15.0 # Rotation (+/- deg)
  translate: 0.1 # Translation (+/- fraction)
  scale: 0.5 # Scale (+/- gain)
  shear: 10.0 # Shear (+/- deg)
  perspective: 0.0 # Perspective (+/- fraction)
  flipud: 0.0 # Flip up-down probability
  fliplr: 0.5 # Flip left-right probability

  # Advanced augmentations
  mosaic: 1.0 # Mosaic augmentation probability
  mixup: 0.0 # MixUp augmentation probability
  copy_paste: 0.0 # Copy-paste augmentation probability

# Validation Configuration
validation:
  val_interval: 1 # Validate every N epochs
  save_json: false # Save results to JSON
  plots: true # Save plots during training

  # Confidence thresholds
  conf: 0.001 # Object confidence threshold
  iou: 0.6 # IoU threshold for NMS

# Hardware Configuration
hardware:
  device: "" # cuda:0 or cpu (empty = auto-detect)
  amp: true # Automatic Mixed Precision training

# Logging & Checkpointing
logging:
  project: "water-meter-ai"
  name: "exp"
  exist_ok: false # Allow overwriting existing project
  save: true # Save train/val checkpoints
  save_period: -1 # Save checkpoint every N epochs (-1 = disabled)

  # Weights & Biases
  wandb:
    enabled: false # Enable W&B logging
    project: "water-meter-detection"
    entity: null # W&B entity/team name

  # TensorBoard
  tensorboard:
    enabled: true

# Inference Configuration (for validation)
inference:
  conf_thres: 0.25 # Confidence threshold
  iou_thres: 0.45 # NMS IoU threshold
  max_det: 300 # Maximum detections per image
  agnostic_nms: false # Class-agnostic NMS

# Export Configuration
export:
  format: ["onnx", "tflite"] # Export formats
  optimize: true # Optimize for mobile
  int8: true # INT8 quantization
  dynamic: false # Dynamic input shape
  simplify: true # ONNX simplify
  opset: 12 # ONNX opset version

# Seed for reproducibility
seed: 42

# Verbose logging
verbose: true
